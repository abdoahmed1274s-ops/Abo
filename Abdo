<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>أكشن داونلودر - Action Downloader</title>
  
  <!-- Tailwind CSS & Google Fonts -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Cairo', sans-serif;
      margin: 0;
      background-color: #1A1C1E;
      color: #E2E2E6;
      -webkit-tap-highlight-color: transparent;
    }
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="h-full flex flex-col justify-between overflow-hidden select-none">

  <!-- Main Container -->
  <div class="flex-1 flex flex-col h-full max-w-md mx-auto w-full bg-[#1A1C1E] border-x border-[#42474E]/30 relative">
    
    <!-- Top Bar -->
    <header class="flex items-center justify-between px-5 py-4 bg-[#1A1C1E] border-b border-[#42474E]/20 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[#D1E4FF] rounded-xl flex items-center justify-center shadow-lg shadow-blue-950/40">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#003258" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 6v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
            <path d="M2 8h20M6 4l2 4M11 4l2 4M16 4l2 4" />
            <path d="M12 11v6m-3-3 3 3 3-3" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg font-bold tracking-tight text-[#D1E4FF] leading-tight">أكشن داونلودر</h1>
          <span class="text-[11px] text-[#8E9199] font-medium">محمل الوسائط السريع</span>
        </div>
      </div>
      
      <div class="flex items-center gap-2">
        <button id="activeBtn" class="relative w-10 h-10 flex items-center justify-center bg-[#2E3033] hover:bg-[#42474E] text-[#E2E2E6] rounded-full transition-colors active:scale-95">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span class="absolute -top-1 -right-1 bg-[#FF5449] text-white text-[10px] font-bold px-1.5 py-0.2 rounded-full border-2 border-[#1A1C1E]">1</span>
        </button>
      </div>
    </header>

    <!-- Scrollable Content Area -->
    <main class="flex-1 overflow-y-auto px-5 py-4 space-y-6 scrollbar-hide">
      
      <!-- Input & Actions Section -->
      <section class="space-y-4">
        <div class="relative">
          <input id="urlInput" type="url" placeholder="الصق رابط الفيديو هنا..." 
            class="w-full h-15 bg-[#2E3033] rounded-2xl pr-4 pl-20 text-base text-[#E2E2E6] placeholder-[#8E9199] border border-[#42474E] focus:border-[#D1E4FF] focus:outline-none transition-all" />
          <button id="pasteBtn" onclick="pasteClipboard()" class="absolute left-2 top-2 h-11 px-4 bg-[#D1E4FF] hover:bg-[#E8F1FF] text-[#003258] rounded-xl text-sm font-bold active:scale-95 transition-transform flex items-center gap-1 shadow-sm">
            <span>لصق</span>
          </button>
        </div>

        <!-- Format & Quality Chips -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide">
          <button class="format-chip active-chip bg-[#004A77] text-[#D1E4FF] border border-[#D1E4FF]/40 px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0 transition-all">1080p MP4</button>
          <button class="format-chip bg-[#2E3033] text-[#C2C7CF] border border-[#42474E] px-3.5 py-1.5 rounded-full text-xs font-medium shrink-0 transition-all">720p HD</button>
          <button class="format-chip bg-[#2E3033] text-[#C2C7CF] border border-[#42474E] px-3.5 py-1.5 rounded-full text-xs font-medium shrink-0 transition-all">480p SD</button>
          <button class="format-chip bg-[#2E3033] text-[#C2C7CF] border border-[#42474E] px-3.5 py-1.5 rounded-full text-xs font-medium shrink-0 transition-all">360p</button>
          <button class="format-chip bg-[#2E3033] text-[#C2C7CF] border border-[#42474E] px-3.5 py-1.5 rounded-full text-xs font-medium shrink-0 transition-all">صوت MP3</button>
        </div>

        <!-- Download Action Button -->
        <button onclick="startDemoDownload()" class="w-full h-14 bg-[#D1E4FF] hover:bg-[#b8d5fc] text-[#003258] rounded-2xl font-bold text-base flex items-center justify-center gap-2 active:scale-[0.98] transition-transform shadow-lg shadow-blue-900/20">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>تحميل فوري</span>
        </button>

        <!-- Demo Samples Quick Picks -->
        <div class="bg-[#1F2023] p-3 rounded-2xl border border-[#2E3033] flex items-center justify-between">
          <div class="flex items-center gap-2 text-xs text-[#8E9199]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[#D1E4FF]"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
            <span>روابط تجريبية عامة:</span>
          </div>
          <div class="flex gap-1.5">
            <button onclick="loadSample('وثائقي الطبيعة - Big Buck Bunny', 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4')" class="text-xs bg-[#2E3033] hover:bg-[#42474E] text-[#D1E4FF] px-2.5 py-1 rounded-lg">طبيعة (MP4)</button>
            <button onclick="loadSample('مقطع سينمائي تجريبي', 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4')" class="text-xs bg-[#2E3033] hover:bg-[#42474E] text-[#D1E4FF] px-2.5 py-1 rounded-lg">فيلم قصير</button>
          </div>
        </div>
      </section>

      <!-- Active Downloads Section -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#69DB7C] animate-pulse"></span>
            جاري التحميل
          </h2>
          <span class="text-xs text-[#8E9199]">ملف قيد المعالجة</span>
        </div>
        
        <!-- Live Download Card -->
        <div class="bg-[#2E3033] border border-[#42474E]/40 rounded-2xl p-4 flex flex-col gap-3 shadow-md">
          <div class="flex gap-3 items-center">
            <div class="w-14 h-14 bg-[#1F2023] rounded-xl flex items-center justify-center border border-[#42474E]/50 shrink-0 text-[#D1E4FF]">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6.47L5.76 10H20v8H4V6.47M22 4h-4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p id="dlTitle" class="text-sm font-bold text-white truncate">وثائقي الطبيعة الخلابة - 1080p.mp4</p>
              <div class="flex justify-between items-center text-[11px] text-[#8E9199] mt-0.5">
                <span id="dlSpeed">2.4 ميجابايت/ث</span>
                <span id="dlEta">باقي 24 ثانية</span>
              </div>
            </div>
          </div>

          <!-- Progress Bar & Actions -->
          <div class="space-y-1.5">
            <div class="w-full h-2 bg-[#1A1C1E] rounded-full overflow-hidden">
              <div id="progressBar" class="h-full bg-gradient-to-r from-[#004A77] to-[#D1E4FF] w-[65%] transition-all duration-300"></div>
            </div>
            <div class="flex justify-between items-center pt-1">
              <span id="progressText" class="text-xs font-bold text-[#D1E4FF]">65% (45 / 70 MB)</span>
              <div class="flex gap-2">
                <button onclick="togglePause(this)" class="w-7 h-7 flex items-center justify-center rounded-full bg-[#42474E] text-white hover:bg-[#5A5F67]">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>
                <button onclick="cancelDownload()" class="w-7 h-7 flex items-center justify-center rounded-full bg-[#42474E] text-[#FF5449] hover:bg-[#5A5F67]">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Completed Downloads Section -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-bold text-white">مكتبة التنزيلات (مكتملة)</h2>
          <span class="text-xs text-[#8E9199]">2 ملفات</span>
        </div>

        <div class="space-y-2.5">
          <!-- Item 1 -->
          <div class="flex items-center gap-3 bg-[#1F2023] p-3 rounded-2xl border border-[#2E3033] hover:border-[#42474E] transition-colors">
            <div class="w-12 h-12 bg-[#2E3033] rounded-xl flex items-center justify-center text-[#D1E4FF] shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-[#E2E2E6] truncate">مقطع ترويجي لفيلم الإثارة 2026.mp4</p>
              <p class="text-[10px] text-[#8E9199] mt-0.5">34.2 ميجابايت • 1080p FHD • اليوم</p>
            </div>
            <button class="p-2 text-[#8E9199] hover:text-[#D1E4FF] active:scale-95">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>

          <!-- Item 2 -->
          <div class="flex items-center gap-3 bg-[#1F2023] p-3 rounded-2xl border border-[#2E3033] hover:border-[#42474E] transition-colors">
            <div class="w-12 h-12 bg-[#2E3033] rounded-xl flex items-center justify-center text-[#69DB7C] shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-[#E2E2E6] truncate">مؤثرات صوتية سنيمائية.mp3</p>
              <p class="text-[10px] text-[#8E9199] mt-0.5">8.6 ميجابايت • 320kbps • أمس</p>
            </div>
            <button class="p-2 text-[#8E9199] hover:text-[#D1E4FF] active:scale-95">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </section>

    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="h-18 bg-[#282A2D] flex items-center justify-around border-t border-[#42474E]/40 px-2 shrink-0">
      <button class="flex flex-col items-center gap-1 py-1 w-20 text-[#D1E4FF]">
        <div class="bg-[#004A77] px-4 py-1 rounded-full">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        </div>
        <span class="text-[11px] font-bold">الرئيسية</span>
      </button>

      <button class="flex flex-col items-center gap-1 py-1 w-20 text-[#8E9199] hover:text-[#D1E4FF] transition-colors">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span class="text-[11px] font-medium">التنزيلات</span>
      </button>

      <button class="flex flex-col items-center gap-1 py-1 w-20 text-[#8E9199] hover:text-[#D1E4FF] transition-colors">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span class="text-[11px] font-medium">الإعدادات</span>
      </button>
    </nav>
  </div>

  <!-- Interactive JavaScript Logic -->
  <script>
    async function pasteClipboard() {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          document.getElementById('urlInput').value = text;
        }
      } catch (err) {
        document.getElementById('urlInput').focus();
      }
    }

    function loadSample(title, url) {
      document.getElementById('urlInput').value = url;
      document.getElementById('dlTitle').innerText = title;
    }

    let progress = 65;
    let isPaused = false;
    let interval = null;

    function startDemoDownload() {
      const url = document.getElementById('urlInput').value;
      if (!url) {
        alert("يرجى إدخال أو لصق رابط الفيديو أولاً");
        return;
      }
      progress = 0;
      isPaused = false;
      if (interval) clearInterval(interval);

      interval = setInterval(() => {
        if (!isPaused && progress < 100) {
          progress += 2;
          document.getElementById('progressBar').style.width = progress + '%';
          document.getElementById('progressText').innerText = progress + '% (' + Math.round(progress * 0.7) + ' / 70 MB)';
          if (progress >= 100) {
            clearInterval(interval);
            alert("اكتمل تنزيل الفيديو بنجاح!");
          }
        }
      }, 300);
    }

    function togglePause(btn) {
      isPaused = !isPaused;
      btn.innerHTML = isPaused 
        ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>' 
        : '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
    }

    function cancelDownload() {
      if (interval) clearInterval(interval);
      progress = 0;
      document.getElementById('progressBar').style.width = '0%';
      document.getElementById('progressText').innerText = '0% (0 / 70 MB)';
      document.getElementById('dlSpeed').innerText = '0 كيلوبايت/ث';
      document.getElementById('dlEta').innerText = 'تم الإلغاء';
    }

    // Chip selection handler
    document.querySelectorAll('.format-chip').forEach(chip => {
      chip.addEventListener('click', function() {
        document.querySelectorAll('.format-chip').forEach(c => {
          c.classList.remove('bg-[#004A77]', 'text-[#D1E4FF]', 'border-[#D1E4FF]/40', 'font-bold');
          c.classList.add('bg-[#2E3033]', 'text-[#C2C7CF]', 'border-[#42474E]', 'font-medium');
        });
        this.classList.remove('bg-[#2E3033]', 'text-[#C2C7CF]', 'border-[#42474E]', 'font-medium');
        this.classList.add('bg-[#004A77]', 'text-[#D1E4FF]', 'border-[#D1E4FF]/40', 'font-bold');
      });
    });
  </script>
</body>
</html>